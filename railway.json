{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ticketing-system-backend && mvn clean package -DskipTests"
  },
  "deploy": {
    "startCommand": "cd ticketing-system-backend && java -jar target/ticketing-system-1.0.0.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
